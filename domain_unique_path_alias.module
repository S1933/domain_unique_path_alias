<?php

/**
 * @file
 * Hook implementations for this module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\domain_unique_path_alias\Hook\DomainUniquePathAliasHooks;
use Drupal\Core\Entity\ContentEntityType;
use Drupal\path_alias\PathAliasInterface;

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function domain_unique_path_alias_path_alias_presave(PathAliasInterface $path_alias) {
  \Drupal::service(DomainUniquePathAliasHooks::class)->pathAliasPresave($path_alias);
}

/**
 * Implements hook_entity_base_field_info().
 */
#[LegacyHook]
function domain_unique_path_alias_entity_base_field_info(ContentEntityType $entity_type) {
  return \Drupal::service(DomainUniquePathAliasHooks::class)->entityBaseFieldInfo($entity_type);
}

/**
 * Implements hook_validation_constraint_alter().
 */
#[LegacyHook]
function domain_unique_path_alias_validation_constraint_alter(array &$definitions) {
  \Drupal::service(DomainUniquePathAliasHooks::class)->validationConstraintAlter($definitions);
}
